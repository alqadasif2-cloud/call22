rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // مفتاح التحقق من عبارة المرور (ملح + نص مشفّر). لا تعديل بعد الإنشاء.
    match /users/{uid}/meta/crypto {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['salt', 'iter', 'checkIv', 'check', 'v'])
        && request.resource.data.salt is string
        && request.resource.data.check is string;
    }

    match /users/{uid}/devices/{deviceId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'model', 'enabled', 'updatedAt', 'lastSyncAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100;
    }

    match /users/{uid}/devices/{deviceId}/records/{recId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && exists(/databases/$(database)/documents/users/$(uid)/devices/$(deviceId))
        && request.resource.data.keys().hasOnly(['type', 'ts', 'iv', 'data', 'v'])
        && request.resource.data.keys().hasAll(['type', 'ts', 'iv', 'data', 'v'])
        && request.resource.data.type in ['call', 'sms', 'clip']
        && request.resource.data.ts is int
        && request.resource.data.iv is string
        && request.resource.data.data is string
        && request.resource.data.data.size() < 600000;
    }

    // أي مسار آخر: ممنوع تمامًا (لا قراءة ولا كتابة عامة)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
